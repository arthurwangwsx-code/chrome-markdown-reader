{
  "manifest_version": 3,
  "name": "Markdown Reader Pro",
  "version": "0.1.0",
  "description": "A local-first Markdown reader with folders, diagrams, math, themes and export.",
  "permissions": ["storage"],
  "host_permissions": ["file:///*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["file:///*"],
    "js": ["content-loader.js"],
    "css": ["reader.css"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["modules/content.js", "modules/chunks/*"],
    "matches": ["file:///*"]
  }],
  "action": {
    "default_title": "Open Markdown workspace",
    "default_popup": "popup.html"
  },
  "options_page": "workspace.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
