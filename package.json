{
  "name": "chrome-markdown-reader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/build.mjs clean",
    "build": "node scripts/build.mjs build",
    "package": "node scripts/build.mjs package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/render.test.ts tests/search.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "store:status": "node scripts/chrome-web-store.mjs status",
    "store:upload": "node scripts/chrome-web-store.mjs upload",
    "store:publish": "node scripts/chrome-web-store.mjs publish",
    "store:assets": "npm run build && node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.20",
    "@markdown-viewer/draw-uml": "^1.4.7",
    "@markdown-viewer/drawio2svg": "^1.5.5",
    "@viz-js/viz": "^3.24.0",
    "docx": "^9.7.1",
    "dompurify": "^3.2.6",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.0",
    "vega-embed": "^7.0.2",
    "vega-interpreter": "^2.1.3",
    "web-worker": "^1.5.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
